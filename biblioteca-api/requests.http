@baseUrl = http://localhost:3000/api/v1
@authorId = REPLACE_WITH_AUTHOR_ID
@bookId = REPLACE_WITH_BOOK_ID
@loanId = REPLACE_WITH_LOAN_ID

### Create an author
POST {{baseUrl}}/authors
Content-Type: application/json

{"name":"Gabriel García Márquez","nationality":"Colombian","birthYear":1927}

### List authors
GET {{baseUrl}}/authors

### Get an author
GET {{baseUrl}}/authors/{{authorId}}

### Update an author
PUT {{baseUrl}}/authors/{{authorId}}
Content-Type: application/json

{"nationality":"Colombian"}

### Create a book
POST {{baseUrl}}/books
Content-Type: application/json

{"title":"One Hundred Years of Solitude","isbn":"9780307474728","authorId":"{{authorId}}","year":1967}

### List books
GET {{baseUrl}}/books

### Get a book
GET {{baseUrl}}/books/{{bookId}}

### Update a book
PUT {{baseUrl}}/books/{{bookId}}
Content-Type: application/json

{"title":"One Hundred Years of Solitude (revised edition)"}

### Create a loan
POST {{baseUrl}}/loans
Content-Type: application/json

{"bookId":"{{bookId}}","userName":"Ana Perez","loanDate":"2026-09-28T10:00:00.000Z"}

### List loans
GET {{baseUrl}}/loans

### Get a loan
GET {{baseUrl}}/loans/{{loanId}}

### Return a loan
PUT {{baseUrl}}/loans/{{loanId}}
Content-Type: application/json

{"returned":true}

### Delete a loan
DELETE {{baseUrl}}/loans/{{loanId}}

### Delete a book
DELETE {{baseUrl}}/books/{{bookId}}

### Delete an author
DELETE {{baseUrl}}/authors/{{authorId}}